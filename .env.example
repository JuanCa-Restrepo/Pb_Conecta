# Copia este archivo como .env y cambia los valores marcados con CAMBIAR.

# Base de datos
POSTGRES_DB=pbconecta
POSTGRES_USER=pbconecta
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=CAMBIAR
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Reglas de la plataforma
DOMINIO_INSTITUCIONAL=pascualbravo.edu.co
FRONTEND_URL=http://localhost:8080
MAX_ARCHIVO_MB=5

# Tokens JWT
JWT_ACCESS_MIN=30
JWT_REFRESH_DIAS=7

# Correo (Mailpit en desarrollo)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_REMITENTE=PB Conecta <no-responder@pascualbravo.edu.co>

# Datos de demostración (se cargan solo si la base de datos está vacía)
CARGAR_DEMO=1
